---
import type { ToolGuide } from "../data/toolGuides.ts";

interface Props {
  name: string;
  guide: ToolGuide;
}

const { name, guide } = Astro.props;
---

<button
  type="button"
  data-tool-help-open
  class="inline-flex items-center gap-1 p-2 text-white/70 hover:text-white hover:bg-white/10 transition-colors"
  aria-label={`About ${name}`}
  aria-haspopup="dialog"
  title="Help"
>
  <span class="inline-flex w-4 h-4 items-center justify-center text-base font-semibold leading-none" aria-hidden="true">?</span>
</button>

<dialog
  id="tool-help"
  class="tool-help m-auto w-[min(42rem,calc(100vw-2rem))] max-h-[min(80vh,48rem)] overflow-hidden p-0 bg-(--color-bg-alt) text-(--color-text) border border-(--color-border)"
  aria-labelledby="tool-help-title"
>
  <article class="flex flex-col max-h-[calc(min(80vh,48rem)-2px)]">
    <header class="flex items-start justify-between gap-4 px-5 py-4 border-b border-(--color-border)">
      <h2 id="tool-help-title" class="text-base font-semibold leading-snug">{guide.title}</h2>
      <button
        type="button"
        data-tool-help-close
        class="shrink-0 p-1 text-(--color-text-light) hover:text-(--color-text) transition-colors"
        aria-label="Close"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </header>
    <div class="overflow-y-auto px-5 py-4 space-y-5 text-sm leading-relaxed">
      <p class="text-(--color-text-muted)">{guide.intro}</p>
      <section>
        <h3 class="mb-2 text-xs uppercase tracking-wider text-(--color-text-light) font-medium">How to use</h3>
        <ol class="list-decimal pl-5 space-y-1 text-(--color-text-muted)">
          {guide.steps.map((step) => <li>{step}</li>)}
        </ol>
      </section>
      <section>
        <h3 class="mb-2 text-xs uppercase tracking-wider text-(--color-text-light) font-medium">FAQ</h3>
        <div class="space-y-3">
          {
            guide.faq.map((item) => (
              <div>
                <h4 class="font-medium">{item.question}</h4>
                <p class="text-(--color-text-muted)">{item.answer}</p>
              </div>
            ))
          }
        </div>
      </section>
    </div>
  </article>
</dialog>

<script is:inline>
  (function () {
    if (window.__toolHelpReady) return;
    window.__toolHelpReady = true;
    document.addEventListener("click", function (event) {
      var target = event.target;
      if (!(target instanceof Element)) return;
      var dialog = document.getElementById("tool-help");
      if (!dialog) return;
      if (target.closest("[data-tool-help-open]")) {
        dialog.showModal();
      } else if (target.closest("[data-tool-help-close]") || target === dialog) {
        dialog.close();
      }
    });
  })();
</script>

<style>
  .tool-help::backdrop {
    background: rgb(0 0 0 / 0.5);
  }
</style>
