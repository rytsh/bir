---
import Layout from "../../layouts/Layout.astro";
import RcFilterTool from "../../components/tools/RcFilterTool.svelte";
import { getToolByPath } from "../../data/tools";

const tool = getToolByPath("/electronics/rc-filter");
---

<Layout title="RC / RL / LC Filter Calculator" description={tool?.description} keywords={tool?.keywords} currentPath="/electronics/rc-filter">
  <h1 slot="navbar-title">Filter Cutoff</h1>
  <RcFilterTool client:load />
</Layout>
