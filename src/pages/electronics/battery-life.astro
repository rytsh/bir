---
import Layout from "../../layouts/Layout.astro";
import BatteryLifeTool from "../../components/tools/BatteryLifeTool.svelte";
import { getToolByPath } from "../../data/tools";

const tool = getToolByPath("/electronics/battery-life");
---

<Layout title="Battery Life Calculator" description={tool?.description} keywords={tool?.keywords} currentPath="/electronics/battery-life">
  <h1 slot="navbar-title">Battery Life</h1>
  <BatteryLifeTool client:load />
</Layout>
