---
import Layout from "../../layouts/Layout.astro";
import SerialTerminalTool from "../../components/tools/SerialTerminalTool.svelte";
import { getToolByPath } from "../../data/tools";

const tool = getToolByPath("/tester/serial");
---

<Layout title="Web Serial Terminal - Arduino and ESP32 Serial Monitor" description={tool?.description} keywords={tool?.keywords} currentPath="/tester/serial">
  <h1 slot="navbar-title">Web Serial Terminal</h1>
  <SerialTerminalTool client:load />
</Layout>
