---
import Layout from "../../layouts/Layout.astro";
import SQLiteStudioTool from "../../components/tools/SQLiteStudioTool.svelte";
import { getToolByPath } from "../../data/tools";

const tool = getToolByPath("/converter/sqlite");
---

<Layout title="SQLite Studio - Browser Database Viewer and SQL Editor" description={tool?.description} keywords={tool?.keywords} currentPath="/converter/sqlite">
  <h1 slot="navbar-title">SQLite Studio</h1>
  <SQLiteStudioTool client:load />
</Layout>
