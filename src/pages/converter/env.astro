---
import Layout from "../../layouts/Layout.astro";
import EnvConverterTool from "../../components/tools/EnvConverterTool.svelte";
import { getToolByPath } from "../../data/tools";

const tool = getToolByPath("/converter/env");
---

<Layout title=".env Converter - JSON, YAML, Kubernetes" description={tool?.description} keywords={tool?.keywords} currentPath="/converter/env">
  <h1 slot="navbar-title">.env Converter</h1>
  <EnvConverterTool client:load />
</Layout>
